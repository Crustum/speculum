includes:
    - phpstan-baseline.neon
    - vendor/cakedc/cakephp-phpstan/extension.neon

parameters:
    level: 7
    paths:
        - src
    bootstrapFiles:
        - tests/bootstrap.php
    cakeDC:
        appNamespace: Crustum\Speculum
    tmpDir: build/phpstan
    ignoreErrors:
        -
            identifier: new.static
            reportUnmatched: false
        -
            message: '#Crustum\\BlazeCast\\#'
            path: src/Watcher/*
            reportUnmatched: false
            # Soft BlazeCast watchers until crustum/blazecast is a published require-dev dep.

services:
